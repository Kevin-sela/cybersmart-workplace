ENVIRONMENT=development
DATABASE_URL=sqlite:///./cybersmart.db
# For PostgreSQL 15+, use a private URL such as:
# DATABASE_URL=postgresql+psycopg://cybersmart:change-me-locally@localhost:5432/cybersmart
JWT_SECRET=replace-with-at-least-32-random-bytes-before-use
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
AUTO_CREATE_SQLITE=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/identity/google/callback
FRONTEND_ORIGIN=http://localhost:3000
